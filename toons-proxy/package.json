{
  "name": "toons-proxy",
  "version": "2.0.0",
  "description": "Proxy server for Toons API with JSON endpoints and image proxy",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun src/index.ts",
    "lint": "biome lint src/ tests/",
    "format": "biome format src/ tests/ --write",
    "check": "biome check src/ tests/",
    "type-check": "tsc --noEmit",
    "test": "bun test tests/api.test.ts tests/types.test.ts",
    "test:watch": "bun test --watch",
    "test:live": "bun test tests/live.test.ts",
    "test:fallback": "bun test tests/fallback.test.ts",
    "test:e2e": "bun test tests/e2e.test.ts",
    "test:all": "bun test",
    "knip": "knip",
    "docker:build": "docker build -t toons-proxy:latest .",
    "docker:run": "docker run -p 3000:3000 toons-proxy:latest",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:down": "docker-compose down"
  },
  "dependencies": {
    "elysia": "^1.1.8",
    "axios": "^1.7.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "bun-types": "latest",
    "knip": "^6.29.0",
    "typescript": "^5.5.4"
  }
}
