{
  "name": "toonlivre-token-server",
  "version": "1.0.0",
  "description": "API server para geração de tokens ToonLivre",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "build": "bun build src/server.ts --outdir dist --target bun",
    "test": "bun run tests/unit.test.ts",
    "test:integration": "bun run tests/integration.test.ts",
    "test:live": "bun run tests/live.test.ts",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:test": "docker compose up -d && sleep 2 && bun run test:integration && docker compose down",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix"
  },
  "dependencies": {
    "crypto-js": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/crypto-js": "^4.2.2",
    "eslint": "9",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0"
  }
}
