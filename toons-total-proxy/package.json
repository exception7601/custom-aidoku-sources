{
  "name": "toons-total-proxy",
  "version": "1.0.0",
  "description": "Proxy server for Toons Total API with JSON endpoints",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun src/index.ts",
    "lint": "biome lint src/ tests/",
    "format": "biome format src/ tests/ --write",
    "check": "biome check src/ tests/",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:live": "bun test tests/api.test.ts",
    "docker:build": "docker build -t toons-total-proxy:latest .",
    "docker:run": "docker run -p 3000:3000 toons-total-proxy:latest",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:down": "docker-compose down"
  },
  "dependencies": {
    "elysia": "^1.1.8",
    "axios": "^1.7.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "typescript": "^5.5.4",
    "bun-types": "latest"
  }
}
